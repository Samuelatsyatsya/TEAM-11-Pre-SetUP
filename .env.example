# Compose project

COMPOSE_PROJECT_NAME=servicehub


# Core runtime metadata
SPRING_APPLICATION_NAME=servicehub-backend
SPRING_PROFILES_ACTIVE=dev
APP_VERSION=0.1.0
APP_ENV=local
APP_API_BASE_PATH=/api/v1
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=25.0


# Backend API
API_RESTART_POLICY=unless-stopped
API_READ_ONLY=true
API_TMPFS_PATH=/tmp
API_MEM_LIMIT=512m
API_CPUS=0.50
API_HEALTHCHECK_SCHEME=http
API_HEALTHCHECK_HOST=localhost
API_HEALTHCHECK_PATH=/actuator/health
API_HEALTHCHECK_START_PERIOD=60s

# Management + CORS
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_HEALTH_SHOW_DETAILS=never
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=false

# Docker build images
BACKEND_BUILD_IMAGE=maven:3.9-eclipse-temurin-17
BACKEND_RUNTIME_IMAGE=eclipse-temurin:17-jre-jammy
FRONTEND_NODE_IMAGE=node:20-slim
DATA_ENGINEERING_PYTHON_IMAGE=python:3.11-slim

# Backend Docker build settings
BACKEND_BUILD_CONTEXT=./backend
BACKEND_DOCKERFILE=Dockerfile
BACKEND_APP_USER=servicehub
BACKEND_APP_GROUP=servicehub
BACKEND_APP_HOME=/app

# Frontend
FRONTEND_BUILD_CONTEXT=./frontend
FRONTEND_DOCKERFILE=Dockerfile
FRONTEND_PORT=3000
FRONTEND_BIND_HOST=0.0.0.0
FRONTEND_RESTART_POLICY=unless-stopped
FRONTEND_READ_ONLY=true
FRONTEND_TMPFS_PATH=/tmp
FRONTEND_MEM_LIMIT=512m
FRONTEND_CPUS=0.50
FRONTEND_APP_USER=servicehub
FRONTEND_APP_GROUP=servicehub
FRONTEND_APP_HOME=/app
FRONTEND_HEALTHCHECK_SCHEME=http
FRONTEND_HEALTHCHECK_HOST=localhost
FRONTEND_HEALTHCHECK_PATH=/
FRONTEND_HEALTHCHECK_START_PERIOD=30s
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
API_INTERNAL_URL=http://api:8080/api/v1
NEXT_TELEMETRY_DISABLED=1

# PostgreSQL
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_RESTART_POLICY=unless-stopped
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPUS=0.50
POSTGRES_HEALTHCHECK_START_PERIOD=30s
POSTGRES_INIT_SCRIPT=./devops/scripts/init-db.sh
PGDATA_VOLUME_NAME=servicehub-pgdata

DB_HOST=postgres
DB_PORT=5432
DB_NAME=servicehub
DB_USERNAME=servicehub_app
DB_USER=servicehub_app
DB_PASSWORD=changeme_use_strong_password
ANALYTICS_DB_USER=analytics_readonly
ANALYTICS_DB_PASSWORD=changeme_analytics_readonly

# MailHog
MAILHOG_IMAGE=mailhog/mailhog:v1.0.1
MAILHOG_RESTART_POLICY=unless-stopped
MAILHOG_MEM_LIMIT=128m
MAILHOG_CPUS=0.25
MAIL_PORT=1025
MAIL_UI_PORT=8025
MAILHOG_SMTP_BIND_ADDR=0.0.0.0:1025
MAILHOG_UI_BIND_ADDR=0.0.0.0:8025

# pgAdmin
PGADMIN_IMAGE=dpage/pgadmin4:latest
PGADMIN_RESTART_POLICY=unless-stopped
PGADMIN_MEM_LIMIT=256m
PGADMIN_CPUS=0.25
PGADMIN_PROFILE=dev
PGADMIN_SERVER_MODE=False
PGADMIN_VOLUME_NAME=servicehub-pgadmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@servicehub.local
PGADMIN_PASSWORD=admin

# Data Engineering / ETL
DATA_ENGINEERING_BUILD_CONTEXT=./data-engineering
DATA_ENGINEERING_DOCKERFILE=Dockerfile
ETL_PROFILE=etl
ETL_RESTART_POLICY=no
ETL_WORKDIR=/app
ETL_ENTRYPOINT=etl_pipeline.py
ETL_USER=servicehub-etl
ETL_GROUP=servicehub-etl
ETL_HEALTHCHECK_START_PERIOD=10s

# Global container controls
CONTAINER_INIT=true
CONTAINER_NO_NEW_PRIVILEGES=true
DOCKER_HEALTHCHECK_INTERVAL=30s
DOCKER_HEALTHCHECK_TIMEOUT=10s
DOCKER_HEALTHCHECK_START_PERIOD=30s
DOCKER_HEALTHCHECK_RETRIES=3

# DevOps helper script knobs
SMOKE_TEST_EMAIL=admin@servicehub.local
SMOKE_TEST_PASSWORD=Admin@Sh2026!
DEPLOY_MAX_RETRIES=3
DEPLOY_RETRY_DELAY_SECONDS=8
DEPLOY_DIAG_LOG_TAIL_LINES=120
