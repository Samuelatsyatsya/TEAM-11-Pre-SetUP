# ServiceHub — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control — it is .gitignore'd.

DB_HOST=postgres
DB_PORT=5432
DB_NAME=servicehub
DB_USERNAME=servicehub_app
DB_USER=servicehub_app
DB_PASSWORD=changeme_use_strong_password

API_PORT=8080
FRONTEND_PORT=3000
MAIL_PORT=1025
MAIL_UI_PORT=8025
PGADMIN_PORT=5050

# Read-only user for analytics pipeline
ANALYTICS_DB_USER=analytics_readonly
ANALYTICS_DB_PASSWORD=changeme_analytics_readonly

JWT_SECRET=changeme_generate_a_256bit_secret_key_here_minimum_32_characters
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

FILE_UPLOAD_DIR=/data/uploads
FILE_MAX_SIZE_MB=5
FILE_MAX_PER_REQUEST=5

MAIL_HOST=mailhog
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@servicehub.local
MAIL_ENABLED=true

JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=25.0"

SPRING_PROFILES_ACTIVE=dev

PGADMIN_EMAIL=admin@servicehub.local
PGADMIN_PASSWORD=admin

SMOKE_TEST_EMAIL=admin@servicehub.local
SMOKE_TEST_PASSWORD=Admin@Sh2026!

DEPLOY_MAX_RETRIES=3
DEPLOY_RETRY_DELAY_SECONDS=8
DEPLOY_DIAG_LOG_TAIL_LINES=120
