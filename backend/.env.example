# ServiceHub Backend local environment
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/servicehub
SPRING_DATASOURCE_USERNAME=servicehub_app
SPRING_DATASOURCE_PASSWORD=changeme_use_strong_password

JWT_SECRET=changeme_generate_a_256bit_secret_key_here_minimum_32_characters
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

CORS_ALLOWED_ORIGINS=http://localhost:3000

FILE_UPLOAD_DIR=/tmp/servicehub-uploads
FILE_MAX_SIZE_MB=5
FILE_MAX_PER_REQUEST=5

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@servicehub.local
MAIL_ENABLED=true

FRONTEND_URL=http://localhost:3000
JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=25.0"
